generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile      Profile?
  submissions  Submission[]

  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id")
  displayName String?  @map("display_name")
  bio         String?
  githubUrl   String?  @map("github_url")
  solvedCount Int      @default(0) @map("solved_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum ChallengeDifficulty {
  easy
  medium
  hard
}

enum ChallengeStatus {
  draft
  published
  archived
}

model Challenge {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  difficulty    ChallengeDifficulty
  category      String
  description   String
  status        ChallengeStatus     @default(published)
  orderIndex    Int                 @default(0) @map("order_index")
  templateKey   String              @map("template_key")
  testKey       String              @map("test_key")
  maxScore      Int                 @default(100) @map("max_score")
  timeLimitMs   Int                 @default(2000) @map("time_limit_ms")
  memoryLimitMb Int                 @default(256) @map("memory_limit_mb")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tags          ChallengeTagLink[]
  submissions   Submission[]

  @@map("challenges")
}

model ChallengeTag {
  id         String             @id @default(cuid())
  name       String             @unique
  links      ChallengeTagLink[]

  @@map("challenge_tags")
}

model ChallengeTagLink {
  challengeId String    @map("challenge_id")
  tagId       String    @map("tag_id")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  tag         ChallengeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([challengeId, tagId])
  @@map("challenge_tag_links")
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  TIMEOUT
  CANCELLED
}

model Submission {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  challengeId  String           @map("challenge_id")
  status       SubmissionStatus
  score        Int?
  passedTests  Int?             @map("passed_tests")
  totalTests   Int?             @map("total_tests")
  errorType    String?          @map("error_type")
  errorMessage String?          @map("error_message")
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  files        SubmissionFile[]
  result       SubmissionResult?

  @@index([userId, submittedAt])
  @@index([challengeId, submittedAt])
  @@map("submissions")
}

model SubmissionFile {
  id           String      @id @default(cuid())
  submissionId String      @map("submission_id")
  path         String
  content      String

  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

model SubmissionResult {
  submissionId    String      @id @map("submission_id")
  stdout          String?
  stderr          String?
  testResultsJson Json?       @map("test_results_json")
  durationMs      Int?        @map("duration_ms")
  memoryMb        Int?        @map("memory_mb")

  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_results")
}